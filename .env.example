# =============================================================================
# MICM Maturity Hub — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string.
# Replit: provisioned automatically; value available in Secrets as DATABASE_URL.
# Local: create a Postgres DB and set the URL here.
DATABASE_URL=postgresql://user:password@localhost:5432/micm_dev

# -----------------------------------------------------------------------------
# Clerk Authentication — Backend
# -----------------------------------------------------------------------------
# Both keys come from the same Clerk application.
# Replit: managed automatically via the Auth pane — do not set manually.
# External Clerk: copy from https://dashboard.clerk.com → API Keys.
#
# Development keys start with pk_test_ / sk_test_
# Production keys start with pk_live_ / sk_live_
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# -----------------------------------------------------------------------------
# Clerk Authentication — Frontend (Vite)
# -----------------------------------------------------------------------------
# Must match CLERK_PUBLISHABLE_KEY above.
# Replit: set automatically when the app is deployed.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# In development this should be empty — Clerk JS loads directly from the CDN.
# In Replit production deployments this is set automatically so Clerk JS is
# proxied through the same domain (avoids cross-origin issues).
# Do NOT set this in local development.
VITE_CLERK_PROXY_URL=

# -----------------------------------------------------------------------------
# Demo Authentication — development/test only
# -----------------------------------------------------------------------------
# Enables one-click demo sign-in against the hardcoded Replit dev Clerk tenant.
# Keep both values false/empty in production. The backend still returns 404 for
# demo sign-in tokens whenever NODE_ENV=production, even if ENABLE_DEMO_AUTH is
# accidentally set to true.
ENABLE_DEMO_AUTH=false
VITE_ENABLE_DEMO_AUTH=false

# -----------------------------------------------------------------------------
# Runtime — set by Replit workflows; override locally as needed
# -----------------------------------------------------------------------------
# Port the API server listens on.
PORT=8080

# Base path the frontend is mounted at (matches artifact.toml previewPath).
# Use "/" for root-mounted deployments.
BASE_PATH=/

# Controls demo-mode routes and logging verbosity.
# Must be "production" in any live environment.
# Startup validation requires CLERK_SECRET_KEY and CLERK_PUBLISHABLE_KEY when
# NODE_ENV=production, and refuses ENABLE_DEMO_AUTH=true in production.
NODE_ENV=development

# -----------------------------------------------------------------------------
# Session (legacy / future use)
# -----------------------------------------------------------------------------
# If Express session middleware is added, set this to a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_at_least_32_random_characters
